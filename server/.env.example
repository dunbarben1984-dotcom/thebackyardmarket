# --- Server ---
PORT=4242
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

# --- Database ---
# e.g. from Railway, Render, Supabase, or Neon
DATABASE_URL=postgres://user:password@host:5432/furrow_field

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys — use the *secret* key, never the publishable key, server-side.
STRIPE_SECRET_KEY=sk_test_...
# From https://dashboard.stripe.com/webhooks after creating the endpoint (see README)
STRIPE_WEBHOOK_SECRET=whsec_...

# Create two Products in Stripe, each with one recurring annual Price, and paste the Price IDs here:
#   Product "Farmer listing"  -> Price: $29.99 / year -> STRIPE_FARMER_PRICE_ID
#   Product "Buyer membership" -> Price: $9.99 / year  -> STRIPE_BUYER_PRICE_ID
STRIPE_FARMER_PRICE_ID=price_...
STRIPE_BUYER_PRICE_ID=price_...
